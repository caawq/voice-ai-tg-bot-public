# Скопируй этот файл в .env и заполни реальными значениями.
# .env в git не коммитится (см. .gitignore).

# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=

# Ключ LLM-провайдера (нужен со следующего шага — распознавание/структурирование)
LLM_API_KEY=

# Строка подключения к БД (нужна со следующего шага — хранение задач/событий/целей)
DATABASE_URL=
