# Скопируй этот файл в .env и заполни реальными значениями.
# .env в git не коммитится (см. .gitignore).

# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=

# Ключ LLM-провайдера (нужен со следующего шага — распознавание/структурирование)
LLM_API_KEY=

# Строка подключения к PostgreSQL.
# Формат: postgresql+asyncpg://user:password@host:5432/dbname
# Голые postgres:// и postgresql:// (как отдают хостинги) тоже подойдут —
# config.require_database_url() сам подставит асинхронный драйвер.
DATABASE_URL=

# Необязательно: путь к Chromium для рендера картинки недели.
# Пусто — Playwright использует свой браузер (playwright install chromium).
CHROMIUM_PATH=
