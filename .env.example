# Скопируй этот файл в .env и заполни реальными значениями.
# .env в git не коммитится (см. .gitignore).

# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=

# Ключ LLM-провайдера, который разбирает голосовые на записи.
LLM_API_KEY=

# Эндпоинт и модель. Подойдёт любой OpenAI-совместимый провайдер:
#   OpenAI       https://api.openai.com/v1        gpt-4o-mini
#   OpenRouter   https://openrouter.ai/api/v1     openai/gpt-4o-mini
#   proxyapi.ru  https://api.proxyapi.ru/openai/v1  gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Как получать структуру: json_schema (strict structured output, надёжнее)
# или tools (function calling, поддерживается шире).
LLM_STRUCTURED_MODE=json_schema

# Модель для транскрипции голосовых. Пусто — берётся LLM_MODEL.
TRANSCRIBE_MODEL=

# Строка подключения к PostgreSQL.
# Формат: postgresql+asyncpg://user:password@host:5432/dbname
# Голые postgres:// и postgresql:// (как отдают хостинги) тоже подойдут —
# config.require_database_url() сам подставит асинхронный драйвер.
# При запуске через docker-compose эту строку можно оставить пустой —
# docker-compose.yml соберёт её сам из POSTGRES_* ниже.
DATABASE_URL=

# Только для docker-compose: логин/пароль/имя локальной базы Postgres,
# которую поднимает сервис db. Пароль сгенерируйте сами (например,
# `openssl rand -hex 16`) — база доступна только внутри docker-сети,
# наружу не торчит, но пустым паролем всё равно не стоит.
POSTGRES_USER=voicebot
POSTGRES_PASSWORD=
POSTGRES_DB=voicebot

# Необязательно: путь к Chromium для рендера картинки недели.
# Пусто — Playwright использует свой браузер (playwright install chromium).
CHROMIUM_PATH=

# Прокси до LLM-провайдера — нужен, если провайдер закрыт по географии
# (Gemini отвечает 400 'User location is not supported for the API use').
# Пример: LLM_PROXY=http://127.0.0.1:8080 или socks5://127.0.0.1:1080
LLM_PROXY=
